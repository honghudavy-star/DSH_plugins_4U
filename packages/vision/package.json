{
  "name": "@dsh-plugins/vision",
  "version": "2.1.0",
  "description": "DSH 原生组合插件：在 composer 中分析粘贴或拖入的图片后发送给文本模型",
  "license": "MIT",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "cordis.patch.yml",
    "luma-mcp/LICENSE",
    "luma-mcp/build/siliconflow-client.js",
    "luma-mcp/build/openai-compatible-client.js",
    "luma-mcp/build/vision-client.js",
    "luma-mcp/build/utils/helpers.js",
    "luma-mcp/build/utils/logger.js",
    "!luma-mcp/README.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "axios": "1.19.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "vision",
    "ocr",
    "image"
  ]
}
