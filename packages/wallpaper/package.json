{
  "name": "@dsh-plugins/wallpaper",
  "version": "2.1.3",
  "description": "DSH 原生组合插件：使用内置预设或本地图片更换 Web 背景壁纸",
  "license": "MIT",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "legacy-cleanup.mjs",
    "cordis.patch.yml",
    "wallpaper.mjs",
    "presets",
    "README.md"
  ],
  "bin": {
    "dsh-plugins-wallpaper": "wallpaper.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "wallpaper",
    "background",
    "theme"
  ]
}
